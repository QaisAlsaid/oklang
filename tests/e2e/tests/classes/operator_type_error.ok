// the operator type-error lane: no operator match means the operand's own
// surface is probed, and a num has no fields. one error per file - the vm
// halts at the first error, so each lane gets its own run.
class Vec2 {
  let x = 0;
  fu init(x) { this.x = x; }
  pub fu operator +(other) { return Vec2(x + other.x); }
  fu operator *(k) { return Vec2(x * k); } // private
  pub fu get() { return x; }
}
let a = Vec2(1);
print((a + Vec2(2)).get()); // expect: 3
print(a + 2); // expect error: class 'num' has no field or method 'x'
