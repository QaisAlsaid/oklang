// varargs and multi-return compose: span the pack, destructure the result
fu minmax(nums...) {
  let mut lo = null;
  let mut hi = null;
  for let n : nums {
    if lo == null or n < lo { lo = n; }
    if hi == null or n > hi { hi = n; }
  }
  return lo, hi;
}

let (lo, hi) = minmax(3, 1, 4, 1, 5, 9, 2, 6);
print lo; // expect: 1
print hi; // expect: 9

let (lo2, hi2) = minmax();
print lo2; // expect: null
print hi2; // expect: null
