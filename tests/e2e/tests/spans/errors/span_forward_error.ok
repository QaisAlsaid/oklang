// v1: `return pair(1, 2);` counts as a ONE-wide return path (the list has one
// expression), so outer's inferred span is 1 - and the destructuring caller
// is told exactly that. the fix inside outer is `let (a, b) = pair(1, 2);
// return a, b;`. compile-time rejection of the forwarding shape needs the
// known-globals table; flagged in the patch notes.
fu pair(a, b) {
  return a, b;
}

fu outer() {
  return pair(1, 2);
}

let (a, b) = outer(); // expect error: it returns 1 values, 2 were requested
