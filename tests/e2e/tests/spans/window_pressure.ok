// a span call with many args: the arg window and the 3-wide result window
// overlap in time (results overwrite dead args) - this is the register
// discipline the whole design rides on
fu three(a, b, c, d, e) {
  return a + b, c + d, e;
}

let (x, y, z) = three(1, 2, 3, 4, 5);
print x; // expect: 3
print y; // expect: 7
print z; // expect: 5
