let mut a = [0, 1, 2, 3, 4];
remove(a, 1, 3);
print len(a); // expect: 3
print a[0]; // expect: 0
print a[1]; // expect: 3
print a[2]; // expect: 4
remove(a, 0, 0); // empty range is a legal no-op
print len(a); // expect: 3
remove(a, 2, 3); // remove the tail
print len(a); // expect: 2
print a[1]; // expect: 3
