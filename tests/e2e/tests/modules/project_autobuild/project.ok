// the auto-build lane: the artifact is missing (the fixture cleans it every
// run), the import itself triggers the consented build
pub let project = {
  "name": "autobuild",
  "natives": {
    "adder": {
      "dir": "native",
      "build": "gcc -shared -fPIC -I$OK_ROOT/include -o adder.so native/adder.c",
      "artifact": "adder.so",
    },
  },
};
