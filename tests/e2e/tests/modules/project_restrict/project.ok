// the restricted lane: --restrict drops OK_CAP_NATIVE_LOAD and
// OK_CAP_NATIVE_BUILD, the declared target refuses with the capability
// error, not a consent prompt
pub let project = {
  "name": "restricted",
  "natives": {
    "adder": {
      "dir": "native",
      "build": "gcc -shared -fPIC -I../../../../../include -o adder.so native/adder.c",
      "artifact": "adder.so",
    },
  },
};
