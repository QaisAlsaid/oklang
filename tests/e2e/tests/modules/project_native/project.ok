// the native target (M12): whatever toolchain, one declared build command,
// the artifact is the importable module. ok build runs it, .okbuild stamps
// the success.
pub let project = {
  "name": "nativeapp",
  "natives": {
    "adder": {
      "dir": "native",
      "build": "gcc -shared -fPIC -I$OK_ROOT/include -o adder.so native/adder.c",
      "artifact": "adder.so",
    },
  },
};
