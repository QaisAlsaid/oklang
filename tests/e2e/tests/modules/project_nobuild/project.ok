// the --no-build lane: consent policy, not capability. the caps stay up,
// the flag refuses the build with the teaching error
pub let project = {
  "name": "nobuild",
  "natives": {
    "adder": {
      "dir": "native",
      "build": "gcc -shared -fPIC -I$OK_ROOT/include -o adder.so native/adder.c",
      "artifact": "adder.so",
    },
  },
};
