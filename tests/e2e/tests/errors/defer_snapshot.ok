fu note(x) {
  print("saw " + (x as str));
  return true;
}

// arguments are evaluated AT THE DEFER SITE: later reassignments
// are not what the deferred call sees
let mut x = 1;
{
  defer note(x);
  x = 99;
}
// expect: saw 1

// the callee too
let mut f = fu(v) { print("first " + (v as str)); return true; };
{
  defer f(7);
  f = fu(v) { print("second " + (v as str)); return true; };
}
// expect: first 7

// complex argument expressions evaluate once, immediately
let mut calls = 0;
fu counted() {
  calls = calls + 1;
  return "arg";
}
{
  defer note(counted());
  print("calls so far " + (calls as str)); // expect: calls so far 1
}
print("calls after " + (calls as str)); // expect: saw arg
// expect: calls after 1
