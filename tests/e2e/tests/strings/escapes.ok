// the P2 string-scanner rework: escapes translate at the parser's unescape
// lane; the scanner itself only learns that a backslash never terminates.
print "a\tb";
// expect: a	b
print "line1\nline2";
// expect: line1
// expect: line2
print "back\\slash"; // expect: back\slash
print "quote\"inside"; // expect: quote"inside
print 'single\'quote'; // expect: single'quote
// the \r escape rides the comparison lane (a raw \r would not split the
// expect line, so equality proves the byte)
print "a\rb" == "a\u{D}b"; // expect: true
// \u{} escapes: the codepoint's utf-8 encoding, inlined
print "\u{41}"; // expect: A
print "\u{E9}" == "é"; // expect: true
print len("\u{1F600}"); // expect: 1
print "\u{1F600}" == "😀"; // expect: true

// the 58 completion: the full control-byte set. every new escape pinned
// against its \u{} spelling - control bytes never ride the expect lane raw.
print "\a" == "\u{7}"; // expect: true
print "\b" == "\u{8}"; // expect: true
print "\e" == "\u{1B}"; // expect: true
print "\f" == "\u{C}"; // expect: true
print "\v" == "\u{B}"; // expect: true
print "\0" == "\u{0}"; // expect: true
// \xNN: the ascii byte escape, one or two hex digits then it stops
print "\x41"; // expect: A
print "\x7F" == "\u{7F}"; // expect: true
print "\x9" == "\t"; // expect: true
print "\xb" == "\v"; // expect: true
// the ANSI color receipt itself: ESC rides the escape lane
print "\x1B[31mred\x1B[0m" == "\u{1B}[31mred\u{1B}[0m"; // expect: true
print "\e[1mbold\e[0m" == "\x1B[1mbold\x1B[0m"; // expect: true
// all single-byte, all one codepoint each
print len("\a\b\e\f\v\0"); // expect: 6
// a \0 that looks like octal's start is just the nul byte and a literal
print "\0x" == "\u{0}x"; // expect: true
// the single-quote lane gets \e too (all four quote flavors share the lane)
print '\e' == "\x1B"; // expect: true
