// and/or are short-circuit VALUE operators (lua style): they return one of
// their operands, not a boolean, and the right side only runs when needed.
print(true and true); // expect: true
print(true and false); // expect: false
print(false and true); // expect: false
print(false and false); // expect: false
print(true or true); // expect: true
print(true or false); // expect: true
print(false or true); // expect: true
print(false or false); // expect: false
// value semantics: the returned value is the deciding operand
print(1 and 2); // expect: 2
print(0 and 2); // expect: 2
print(null and 2); // expect: null
print(false and 2); // expect: false
print(1 or 2); // expect: 1
print(null or 2); // expect: 2
print(false or 2); // expect: 2
// short circuit: the right side must not run
let mut runs = 0;
fu bump(v) { runs += 1; return v; }
print(false and bump(1)); // expect: false
print(runs); // expect: 0
print(true or bump(1)); // expect: true
print(runs); // expect: 0
print(true and bump(5)); // expect: 5
print(runs); // expect: 1
print(false or bump(6)); // expect: 6
print(runs); // expect: 2
// the classic guard: safe when x is null
fu clamp(x) { return x != null and x > 0 then x otherwise 0; }
print(clamp(5)); // expect: 5
print(clamp(-5)); // expect: 0
print(clamp(null)); // expect: 0
// precedence: not > and > or, comparison binds tighter than both
print(not true and false); // expect: false
print(not (true and false)); // expect: true
print(true or false and false); // expect: true
print((true or false) and false); // expect: false
print(1 < 2 and 2 < 3); // expect: true
print(1 > 2 or 2 > 3); // expect: false
// chains
print(1 and 2 and 3); // expect: 3
print(null and 2 and 3); // expect: null
// 0 is truthy, so the chain stops at 0
print(null or 0 or 7); // expect: 0
// identifier operands (the P6-round-two find): an identifier rhs resolves
// to its own register without emitting anything, so the fall-through path
// must explicitly land it in the result register - before the fix these
// printed the stale left value (or unwritten null)
let x = false;
let y = 42;
print(x or y); // expect: 42
print(x and y); // expect: false
print(true and y); // expect: 42
print(false or y); // expect: 42
print(y or x); // expect: 42
print(y and x); // expect: false
let a = 3;
let b = 7;
print(a > b or a); // expect: 3
print(a < b and b); // expect: 7
print(a < b or b); // expect: true
print(a > b and a); // expect: false
// the same shapes inside a larger expression
print((x or y) + 1); // expect: 43
print(not (x or x)); // expect: true
// and as a call argument (the window discipline)
fu echo(v) { return v; }
print(echo(x or y)); // expect: 42
print(echo(y and x)); // expect: false
// upvalue and global homes for the lazy rhs (a lambda capture, a glob)
glob let g = 9;
fu capture() {
  let u = 5;
  return fu() { return x or u; };
}
print(capture()()); // expect: 5
print(x or g); // expect: 9
print(g and x); // expect: false
