// floored remainder (python/lua): the sign follows the divisor, so the result
// of x % n for positive n always lands in [0, n) - negative indices included.
print(7 % 3); // expect: 1
print(7.5 % 2); // expect: 1.5
print(-7 % 3); // expect: 2
print(7 % -3); // expect: -2
print(-7.5 % 2); // expect: 0.5
print(0 % 5); // expect: 0
print(5.3 % 2.1); // expect: 1.1
print(-1 % 5); // expect: 4

// precedence: % sits with * and / (PREC_PRODUCT), left-associative
print(10 % 4 + 1); // expect: 3
print(2 + 10 % 4); // expect: 4
print(2 * 5 % 3); // expect: 1
print(100 % 30 % 7); // expect: 3

// compound assign: names in place, single evaluation
let mut x = 10;
x %= 3;
print(x); // expect: 1
let mut y = 100;
y %= 30;
y %= 7;
print(y); // expect: 3

// dogfood: parity in a numeric-for
let mut evens = 0;
for let i = 0 : 10 {
  if i % 2 == 0 {
    evens = evens + 1;
  }
}
print(evens); // expect: 5

// dogfood: wraparound with a negative offset - the floor payoff
let tiles = ["a", "b", "c"];
let mut pos = 0 - 1;
print(tiles[pos % 3]); // expect: c
