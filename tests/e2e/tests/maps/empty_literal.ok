let m = {:};
print len(m); // expect: 0
m["k"] = true;
print len(m); // expect: 1
print m["k"]; // expect: true

// a bare {} in expression position is rejected - the empty map is {:}
let x = {}; // expect error: empty '{}' is not an expression, the empty map literal is '{:}'.
// a bare {} STATEMENT stays an empty block
{ print "block"; } // expect: block
